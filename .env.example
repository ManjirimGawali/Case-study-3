# Copy to .env and edit. Everything is optional; defaults work out of the box.
PORT=4200

# Storage: empty = JSON files in data/. Or a MongoDB URL (local or free Atlas).
MONGO_URL=

# Day 1 of a "Day"-numbered sheet maps to this date (Day 27 -> May 27 by default).
START_DATE=2026-05-01

# Email delivery (nodemailer). Empty SMTP_HOST = digests are only written to data/outbox/.
#  Mailpit (local, free):   SMTP_HOST=127.0.0.1  SMTP_PORT=1025   (inbox at http://localhost:8025)
#  Gmail (real delivery):   SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#                           SMTP_USER=you@gmail.com  SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FC P&L Monitor <monitor@localhost>
# Optional: send every digest here instead of the real managers (safe demos).
MAIL_REDIRECT_TO=

# Optional Slack incoming webhook (free). Per-FC webhooks can also go in config/fcs.json.
SLACK_WEBHOOK_URL=

# Optional local LLM (Ollama) to phrase insights. Numbers are always computed by code
# and any LLM sentence with a number not in the facts is discarded (template used).
AI_INSIGHTS=false
OLLAMA_URL=http://localhost:11434
AI_MODEL=qwen2.5:3b
AI_MAX_INSIGHTS=60

# Daily automatic run: process new files dropped in inbox/ at this time and send digests.
SCHEDULE_ENABLED=false
SCHEDULE_TIME=08:00
WATCH_DIR=inbox

# Link put in digests.
PUBLIC_URL=http://localhost:4200
